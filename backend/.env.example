# Database Configuration
DATABASE_URL=sqlite:///network_compliance.db

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
DEBUG=True
PORT=5000

# SMTP Configuration (for email alerts)
SMTP_ENABLED=false
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=alerts@company.com
SMTP_PASSWORD=your-smtp-password
ADMIN_EMAIL=admin@company.com

# Network Configuration
NETWORK_RANGE=192.168.1.0/24
POLL_INTERVAL=30
AUTO_START_MONITORING=false

# Device Naming Convention (for unauthorized device detection)
# Pattern: DEPT-DEVICETYPE-NNNN (e.g., IT-WS-0042, HR-LPT-0023)
# Adjust regex pattern to match your company's naming culture
NAMING_PATTERN=^[A-Z]{2,3}-[A-Z]{2,4}-\d{4}$
NAMING_DESCRIPTION=DEPT-DEVICETYPE-NNNN (e.g., IT-WS-0042, HR-LPT-0023)

# Certificate Configuration
CA_VALIDITY_DAYS=3650
CERT_VALIDITY_DAYS=365
